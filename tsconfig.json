{
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "types": ["node", "vitest/globals"]
  },
  "exclude": ["node_modules", "dist"]
}
